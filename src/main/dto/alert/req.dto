export cv.beriholic.beeyes.models.entity.AlertRuleDO

input CreateAlertRequest {
    name: String
    serverId: String?
    metricType: Int
    condition: Int
    threshold: Double
    durationSeconds: Int?
    silenceSeconds: Int?
    enabled: Boolean
}

input UpdateAlertRequest {
    id: String
    name: String
    serverId: Long?
    metricType: Int
    condition: Int
    threshold: Double
    durationSeconds: Int?
    silenceSeconds: Int?
    enabled: Boolean
}

input DeleteAlertRequest {
    id: String
}
