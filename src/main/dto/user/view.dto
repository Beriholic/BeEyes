export cv.beriholic.beeyes.models.entity.UserDO

UserBaseView {
    id
    username
    fullName
    email
    phone
}

ServerIdListUnderUserView {
    servers {
        id
    }
}

ManageUserView {
    id
    username
    fullName
    email
    phone
    flat(role) {
        role as roleCode
    }
    !depth(1)
    parent*
}

CreateUserView {
    username
    fullName
    email
    phone
    password: String
    flat(role) {
        role as roleCode
    }
}

ResetUserView {
    username
    fullName
    email
    phone
    password: String
    flat(role) {
        role as roleCode
    }
}
