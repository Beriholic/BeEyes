export cv.beriholic.beeyes.models.entity.UserDO

input QueryManageUserListRequest {
    username: String?
    fullName: String?
    email: String?
    phone: String?
    ruleCode: Short?
    parentId: String?

    pageIndex: Int
    pageSize: Int
}

input CreateUserRequest {
    username
    fullName
    email
    phone
    roleCode: Short
    parentId: String
}

input UpdateUserRequest {
    userId: String
    username
    fullName
    email
    phone
    roleCode: Short
    parentId: String
}

input ResetUserPasswordRequest {
    userId: String
}

input DeleteUserRequest {
    userId: String
}
